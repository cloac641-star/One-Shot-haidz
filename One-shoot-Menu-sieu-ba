local function getTarget()
    local best,bestScore=nil,math.huge
    local camPos=Cam.CFrame.Position
    local center=Vector2.new(Cam.ViewportSize.X/2,Cam.ViewportSize.Y/2)
    for _,char in ipairs(cachedChars) do
        if char.Parent and not isModelDead(char) then
            local hum=char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health>0 then
                local plr=Players:GetPlayerFromCharacter(char)
                local skip=false
                if S.TeamCheck and plr and LP.Team and plr.Team==LP.Team then
                    skip=true
                end
                if not skip then
                    local part=getBestAimPart(char,S.AimPart)
                    if part then
                        local sp,on=Cam:WorldToViewportPoint(part.Position)
                        local dCross
                        if on then dCross=(Vector2.new(sp.X,sp.Y)-center).Magnitude
                        else dCross=99999 end
                        if S.Aim360 or (on and dCross<=S.AimFOV) or (not on and dCross<=S.AimFOV*2) then
                            if not S.WallCheck or isVis(part,char) then
                                local score
                                if S.TargetPriority=="Tâm Ngắm" then score=dCross
                                elseif S.TargetPriority=="Khoảng Cách" then
                                    score=(camPos-part.Position).Magnitude
                                else score=hum.Health end
                                if score<bestScore then
                                    best=part bestScore=score
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local function getNearestForTele()
    local myChar=LP.Character
    local myRoot=myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local myPos=myRoot.Position
    local best,bestD=nil,math.huge
    local rng=S.TeleRange
    for _,char in ipairs(cachedChars) do
        if char.Parent and char~=myChar and not isModelDead(char) then
            local hum=char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health>0 then
                local root=char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
                    or char:FindFirstChild("Head")
                if root then
                    local d=(root.Position-myPos).Magnitude
                    if d<=rng and d<bestD then
                        best=char bestD=d
                    end
                end
            end
        end
    end
    return best
end

local aimCamActive=false
