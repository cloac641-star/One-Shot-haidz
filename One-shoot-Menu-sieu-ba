        aimCamActive=false
        pcall(function()
            Cam.CameraType=Enum.CameraType.Custom
            local h=getHum()
            if h then Cam.CameraSubject=h end
        end)
    end
end

local lastAuto=0
local lastTele=0
local lastScan=0

table.insert(conns,RS.RenderStepped:Connect(function(dt)
    local now=tick()
    if now-lastScan>0.15 then
        lastScan=now
        refreshChars()
    end

    if S.ShowFOV and S.AimOn and not S.Aim360 then
        Fov.Visible=true
        Fov.Position=Vector2.new(Cam.ViewportSize.X/2,Cam.ViewportSize.Y/2)
        Fov.Radius=S.AimFOV
        if S.FOVRainbow then Fov.Color=rainbow()
        else Fov.Color=Color3.fromRGB(0,170,255) end
    else Fov.Visible=false end

    local target=getTarget()
    S.CurTarget=target
    local aiming=S.AimOn and (S.AimHeld or S.AimMode=="Bật Tắt")
    local snapping=tick()<S.SnapUntil

    if S.TeleLobby and S.TeleLobbyCF then
        local c=LP.Character
        local hrp=c and c:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame=S.TeleLobbyCF
            hrp.AssemblyLinearVelocity=Vector3.zero
            hrp.RotVelocity=Vector3.zero
            if S.TeleLobbyAutoWallbang then
                S.Wallbang=true
                S.SilentAim=true
                S.SilentAimHead=true
            end
        end
    end

    if S.TeleWall then
        if now-lastTele>S.TeleDelay then
            local teleTarget=getNearestForTele()
            if teleTarget then
                lastTele=now
                local hrp=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                local hum=getHum()
                if hrp and hum then
                    local tRoot=teleTarget:FindFirstChild("HumanoidRootPart")
                        or teleTarget.PrimaryPart or teleTarget:FindFirstChild("Head")
                    if tRoot then
                        local wasPS=hum.PlatformStand
                        hum.PlatformStand=true
                        local dir=(tRoot.Position-hrp.Position)
                        dir=Vector3.new(dir.X,0,dir.Z)
                        if dir.Magnitude<0.1 then dir=Vector3.new(0,0,-1) end
                        dir=dir.Unit
                        local telePos=tRoot.Position-dir*S.TeleDist+Vector3.new(0,1,0)
                        hrp.CFrame=CFrame.new(telePos,tRoot.Position)
                        hrp.AssemblyLinearVelocity=Vector3.zero
                        hrp.RotVelocity=Vector3.zero
                        hum.PlatformStand=wasPS
                    end
                end
            end
        end
    end

    if target and target.Parent and (aiming or snapping) then
        setAimCam(true)
        local aimPos=target.Position
        if S.Predict>0 then
            local v=target.AssemblyLinearVelocity or Vector3.zero
            aimPos=aimPos+v*(S.Predict/100)
        end
        if S.Aim360 or S.AimSmooth>=100 then
            Cam.CFrame=CFrame.new(Cam.CFrame.Position,aimPos)
        else
            local alpha=math.clamp(S.AimSmooth/100,0.05,1)
            Cam.CFrame=Cam.CFrame:Lerp(CFrame.new(Cam.CFrame.Position,aimPos),alpha)
        end
    else
        setAimCam(false)
    end

    if S.AutoShoot and target then
        local cd=math.max(S.MagicRate/100,0.08)
        if now-lastAuto>cd then
            lastAuto=now
            local t=getTool()
            if t then
                pcall(function() t:Activate() end)
            end
            if S.WC then
                for name,method in pairs(S.WC) do
                    if type(method)=="function" and
                       (name:lower():find("fire") or name:lower():find("shoot")) then
                        pcall(function() method(S.WC) end)
                        break
                    end
                end
            end
        end
    end

    if S.SkyFly then
        local c=LP.Character
        local hrp=c and c:FindFirstChild("HumanoidRootPart")
        if hrp then
            local curY=hrp.Position.Y
            local targetY
            if S.SkyHopMode then
                if not _G.__skyPhase then
                    _G.__skyPhase="up"
                    _G.__skyPhaseStart=now
                end
                if _G.__skyPhase=="up" and now-_G.__skyPhaseStart>S.SkyUpTime then
                    _G.__skyPhase="down"
                    _G.__skyPhaseStart=now
                elseif _G.__skyPhase=="down" and now-_G.__skyPhaseStart>S.SkyDownTime then
                    _G.__skyPhase="up"
                    _G.__skyPhaseStart=now
                end
                targetY=(_G.__skyPhase=="up") and S.SkyHeight or 20
            else
                targetY=S.SkyHeight
            end
            local newY=curY+(targetY-curY)*math.min(dt*4,1)
            local px,pz=hrp.Position.X,hrp.Position.Z
            local lookDir=Cam.CFrame.LookVector
            lookDir=Vector3.new(lookDir.X,0,lookDir.Z)
            if lookDir.Magnitude>0.001 then lookDir=lookDir.Unit
            else lookDir=Vector3.new(0,0,-1) end
            local targetPos=Vector3.new(px,newY,pz)
            hrp.CFrame=CFrame.new(targetPos,targetPos+lookDir)
            hrp.AssemblyLinearVelocity=Vector3.new(
                hrp.AssemblyLinearVelocity.X,0,hrp.AssemblyLinearVelocity.Z)
        end
    end

    local camCenter=Vector2.new(Cam.ViewportSize.X/2,Cam.ViewportSize.Y/2)
    local vpY=Cam.ViewportSize.Y
    for model,d in pairs(EspData) do
        if not model.Parent or not S.EspOn or isModelDead(model) then
            d.bg.Enabled=false
            if d.ch then d.ch.FillTransparency=1 d.ch.OutlineTransparency=1 end
            d.tracer.Visible=false
            if d.box then d.box.Visible=false end
        else
            local hum=model:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health<=0 then
                d.bg.Enabled=false
                if d.ch then d.ch.FillTransparency=1 d.ch.OutlineTransparency=1 end
                d.tracer.Visible=false
                if d.box then d.box.Visible=false end
            else
                local okBox,cfBox,szBox=pcall(function() return model:GetBoundingBox() end)
                local centerPos=(okBox and cfBox.Position) or model:GetPivot().Position
                local dist=(Cam.CFrame.Position-centerPos).Magnitude
                if dist>S.EspMax then
                    d.bg.Enabled=false
                    d.tracer.Visible=false
                    if d.box then d.box.Visible=false end
                else
                    d.bg.Enabled=true
                    local col=S.EspRainbow and rainbow() or S.EspCol
                    local head=model:FindFirstChild("Head")
                    local adorneePart=(head and head:IsA("BasePart")) and head
                        or model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                    if adorneePart then
                        if d.bg.Adornee~=adorneePart then d.bg.Adornee=adorneePart end
                    end
                    d.name.Visible=S.EspName
                    d.name.Text=getDisplayName(model)
                    d.name.TextColor3=col
                    d.dist.Visible=S.EspDist
                    d.dist.Text=string.format("[%d m]",math.floor(dist))
                    d.dist.TextColor3=col
                    local hpRatio=math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
                    d.hpBG.Visible=S.EspHP
                    d.hp.Size=UDim2.new(hpRatio,0,1,0)
                    d.hp.BackgroundColor3=Color3.fromRGB(255*(1-hpRatio),255*hpRatio,0)
                    if d.ch then
                        if d.ch.Parent~=model then d.ch.Parent=model end
                        d.ch.FillColor=col d.ch.OutlineColor=col
                        d.ch.FillTransparency=0.6 d.ch.OutlineTransparency=0
                    end
                    if S.EspTracer then
                        local hp2=w2s(centerPos)
                        d.tracer.Color=col d.tracer.Visible=true
                        local startY=vpY*(S.TracerY/100)
                        d.tracer.From=Vector2.new(Cam.ViewportSize.X/2,startY)
                        d.tracer.To=hp2
                    else d.tracer.Visible=false end

                    if d.box then
                        if S.EspBox and okBox and cfBox and szBox then
                            local corners={
                                cfBox*Vector3.new(-szBox.X/2,-szBox.Y/2,-szBox.Z/2),
                                cfBox*Vector3.new(szBox.X/2,-szBox.Y/2,-szBox.Z/2),
                                cfBox*Vector3.new(-szBox.X/2,szBox.Y/2,-szBox.Z/2),
                                cfBox*Vector3.new(szBox.X/2,szBox.Y/2,-szBox.Z/2),
                                cfBox*Vector3.new(-szBox.X/2,-szBox.Y/2,szBox.Z/2),
                                cfBox*Vector3.new(szBox.X/2,-szBox.Y/2,szBox.Z/2),
                                cfBox*Vector3.new(-szBox.X/2,szBox.Y/2,szBox.Z/2),
                                cfBox*Vector3.new(szBox.X/2,szBox.Y/2,szBox.Z/2)
                            }
                            local minX,minY=math.huge,math.huge
                            local maxX,maxY=-math.huge,-math.huge
                            local hasVis=false
                            for _,corner in ipairs(corners) do
                                local sp,on=w2s(corner)
                                if on then
                                    hasVis=true
                                    minX=math.min(minX,sp.X)
                                    maxX=math.max(maxX,sp.X)
                                    minY=math.min(minY,sp.Y)
                                    maxY=math.max(maxY,sp.Y)
                                end
                            end
                            if hasVis then
                                d.box.Position=Vector2.new(minX-2,minY-2)
                                d.box.Size=Vector2.new((maxX-minX)+4,(maxY-minY)+4)
                                d.box.Color=col
                                d.box.Visible=true
                            else
                                d.box.Visible=false
                            end
                        else
                            d.box.Visible=false
                        end
                    end
                end
            end
        end
    end

    if S.SpeedOn then
        local h=getHum()
        if h and h.WalkSpeed~=S.SpeedVal then h.WalkSpeed=S.SpeedVal end
    end
    if S.JumpOn then
        local h=getHum()
        if h and h.JumpPower~=S.JumpVal then
            h.UseJumpPower=true h.JumpPower=S.JumpVal
        end
    end
    if S.FlyOn and not flyConn then startFly() end
    if not S.FlyOn and flyConn then stopFly() end
    if S.TriggerBot and target then
        local sp=w2s(target.Position)
        if (sp-camCenter).Magnitude<12 then sendM1() end
    end
    if S.WMOn then
        local fps=math.floor(1/math.max(dt,1e-4))
        local tags=""
        if S.SilentHooked then tags=tags.." S" end
        if S.TeleWall then tags=tags.." T" end
        if S.TeleLobby then tags=tags.." LB" end
        if S.Wallbang then tags=tags.." W" end
        if S.Aim360 then tags=tags.." 360" end
        if S.SkyFly then tags=tags.." SKY" end
        if S.Immortal then tags=tags.." ♾" end
        if S.GodModeReal then tags=tags.." GM" end
        if S.AntiAim then tags=tags.." AA" end
        if S.PotatoMode then tags=tags.." 🥔" end
        if S.LoadNPC then tags=tags.." NPC" end
        WM.Text=string.format("ONE SHOT v12 | %d FPS | %d🎯 | %s%s",
            fps,#cachedChars,target and "✓" or "—",tags)
    end
end))

