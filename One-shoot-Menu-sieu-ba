local function isModelHidden(model)
    if not S.DetectHidden then return false end
    local totalCount=0
    local visibleCount=0
    for _,p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then
            totalCount=totalCount+1
            local trans=p.Transparency
            local ltm=0
            pcall(function() ltm=p.LocalTransparencyModifier end)
            local maxT=math.max(trans,ltm)
            if maxT<0.9 then
                visibleCount=visibleCount+1
            end
        end
    end
    if totalCount==0 then return true end
    return visibleCount==0
end

local function isModelDead(model)
    if not model or not model.Parent then return true end
    local hum=model:FindFirstChildOfClass("Humanoid")
    if not hum then return true end
    if hum.Health<=0 then return true end
    local ok,state=pcall(function() return hum:GetState() end)
    if ok and state==Enum.HumanoidStateType.Dead then return true end
    if model:GetAttribute("Eliminated")==true then return true end
    if model:GetAttribute("Dead")==true then return true end
    if model:GetAttribute("IsDead")==true then return true end
    if model:GetAttribute("Alive")==false then return true end
    if isModelHidden(model) then return true end
    return false
end

local function refreshChars()
    local list={}
    local seen={}
    local camPos=Cam.CFrame.Position
    local rngPlayer=S.LoadRangePlayer
    local rngNPC=S.LoadRange
    local rngP2=rngPlayer*rngPlayer
    local rngN2=rngNPC*rngNPC
    local function rootOf(model)
        return model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
    end
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LP then
            local c=plr.Character
            if c and c:IsDescendantOf(WS) then
                if not (S.SkipDead and isModelDead(c)) then
                    local root=rootOf(c)
                    if root then
                        local d=(root.Position-camPos)
                        if d.X*d.X+d.Y*d.Y+d.Z*d.Z <= rngP2 then
                            if not seen[c] then
                                seen[c]=true
                                pcall(function() c:SetAttribute("OS_IsPlayer",true) end)
                                pcall(function() c:SetAttribute("OS_PlayerName",plr.Name) end)
                                table.insert(list,c)
                            end
                        end
                    end
                end
            end
        end
    end
    if S.LoadNPC then
        local function scan(container,depth)
            if depth>4 then return end
            for _,obj in ipairs(container:GetChildren()) do
                if obj:IsA("Model") and obj~=LP.Character and not seen[obj] then
                    local hum=obj:FindFirstChildOfClass("Humanoid")
                    if hum then
                        local isPlrChar=Players:GetPlayerFromCharacter(obj)~=nil
                        if not isPlrChar then
                            if not (S.SkipDead and isModelDead(obj)) then
                                local root=rootOf(obj)
                                if root then
                                    local d=(root.Position-camPos)
                                    if d.X*d.X+d.Y*d.Y+d.Z*d.Z <= rngN2 then
                                        seen[obj]=true
                                        pcall(function() obj:SetAttribute("OS_IsPlayer",false) end)
                                        table.insert(list,obj)
                                    end
                                end
                            end
                        end
                    end
                elseif obj:IsA("Folder") then
                    scan(obj,depth+1)
                end
            end
        end
        scan(WS,0)
    end
    cachedChars=list
end

