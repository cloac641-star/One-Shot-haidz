local EspData={}
local function newEspForModel(model)
    if EspData[model] then return end
    local bg=Instance.new("BillboardGui")
    bg.Size=UDim2.new(0,200,0,60) bg.AlwaysOnTop=true
    bg.StudsOffsetWorldSpace=Vector3.new(0,3,0) bg.Parent=Gui
    bg.Enabled=false
    local nameL=Instance.new("TextLabel",bg)
    nameL.Size=UDim2.new(1,0,0,16) nameL.Position=UDim2.new(0,0,0,0)
    nameL.BackgroundTransparency=1
    nameL.TextColor3=Color3.fromRGB(255,255,255)
    nameL.Font=Enum.Font.GothamBold nameL.TextSize=13
    nameL.TextStrokeTransparency=0
    local distL=Instance.new("TextLabel",bg)
    distL.Size=UDim2.new(1,0,0,14) distL.Position=UDim2.new(0,0,0,16)
    distL.BackgroundTransparency=1
    distL.TextColor3=Color3.fromRGB(255,255,255)
    distL.Font=Enum.Font.Gotham distL.TextSize=11
    distL.TextStrokeTransparency=0
    local hpBG=Instance.new("Frame",bg)
    hpBG.Size=UDim2.new(0,60,0,5) hpBG.Position=UDim2.new(0.5,-30,0,32)
    hpBG.BackgroundColor3=Color3.fromRGB(30,30,30) hpBG.BorderSizePixel=0
    Instance.new("UICorner",hpBG).CornerRadius=UDim.new(0,2)
    local hpFill=Instance.new("Frame",hpBG)
    hpFill.Size=UDim2.new(1,0,1,0)
    hpFill.BackgroundColor3=Color3.fromRGB(0,255,0)
    hpFill.BorderSizePixel=0
    Instance.new("UICorner",hpFill).CornerRadius=UDim.new(0,2)
    local ch=Instance.new("Highlight")
    ch.FillTransparency=1 ch.OutlineTransparency=1
    ch.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    ch.Parent=model
    local tracer=Drawing.new("Line")
    tracer.Thickness=1 tracer.Transparency=0.85 tracer.Visible=false
    local box=Drawing.new("Square")
    box.Thickness=1.5
    box.Filled=false
    box.Transparency=1
    box.Color=Color3.fromRGB(255,60,60)
    box.Visible=false
    EspData[model]={bg=bg,name=nameL,dist=distL,hp=hpFill,hpBG=hpBG,
        ch=ch,tracer=tracer,box=box}
end
local function delEsp(model)
    local d=EspData[model]
    if d then
        if d.bg then d.bg:Destroy() end
        if d.ch then d.ch:Destroy() end
        if d.tracer then pcall(function() d.tracer:Remove() end) end
        if d.box then pcall(function() d.box:Remove() end) end
        EspData[model]=nil
    end
end

local function hookPlayerDied(plr)
    if plr==LP then return end
    local function onChar(c)
        local hum=c:WaitForChild("Humanoid",5)
        if not hum then return end
        hum.Died:Connect(function()
            refreshChars()
            if EspData[c] then pcall(delEsp,c) end
        end)
        hum.HealthChanged:Connect(function(hp)
            if hp<=0 then
                refreshChars()
                if EspData[c] then pcall(delEsp,c) end
            end
        end)
    end
    plr.CharacterAdded:Connect(onChar)
    if plr.Character then onChar(plr.Character) end
end
for _,plr in ipairs(Players:GetPlayers()) do
    hookPlayerDied(plr)
end
Players.PlayerAdded:Connect(hookPlayerDied)

task.spawn(function()
    while task.wait(0.15) do
        refreshChars()
        local validSet={}
        for _,c in ipairs(cachedChars) do
            validSet[c]=true
            if not EspData[c] then pcall(newEspForModel,c) end
        end
        for model in pairs(EspData) do
            if not validSet[model] then pcall(delEsp,model) end
        end
    end
end)

local unloaded=false
function unload()
    if unloaded then return end
    unloaded=true
    stopGod()
    local h=getHum()
    if h then
        h.WalkSpeed=16 h.UseJumpPower=false h.JumpPower=50 h.PlatformStand=false
    end
    Cam.FieldOfView=70
    pcall(function()
        Cam.CameraType=Enum.CameraType.Custom
        local hh=getHum() if hh then Cam.CameraSubject=hh end
    end)
    Light.Brightness=1 Light.FogEnd=100000 Light.ClockTime=14
    Light.Ambient=Color3.fromRGB(70,70,70)
    Light.OutdoorAmbient=Color3.fromRGB(128,128,128)
    if flyConn then flyConn:Disconnect() flyConn=nil end
    if potatoConn then potatoConn:Disconnect() potatoConn=nil end
    for model,d in pairs(EspData) do
        if d.bg then d.bg:Destroy() end
        if d.ch then d.ch:Destroy() end
        if d.tracer then pcall(function() d.tracer:Remove() end) end
        if d.box then pcall(function() d.box:Remove() end) end
    end
    EspData={}
    if Fov then pcall(function() Fov:Remove() end) end
    for _,c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    conns={}
    if Gui then Gui:Destroy() end
    if blur then blur:Destroy() end
    notify("One Shot v12","Đã gỡ script")
end

