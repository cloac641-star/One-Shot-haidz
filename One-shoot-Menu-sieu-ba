local function getCharParts(char)
    local parts={}
    for _,v in ipairs(char:GetDescendants()) do
        if v:IsA("BasePart") then table.insert(parts,v) end
    end
    return parts
end

local function getBestAimPart(char,mode)
    local head=char:FindFirstChild("Head")
    local hrp=char:FindFirstChild("HumanoidRootPart")
    local upper=char:FindFirstChild("UpperTorso")
    local torso=char:FindFirstChild("Torso")
    if mode=="Đầu" then
        if head and head:IsA("BasePart") then return head end
        local highest,maxY=nil,-math.huge
        for _,p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.Position.Y>maxY then
                maxY=p.Position.Y highest=p
            end
        end
        return highest or hrp
    elseif mode=="Thân" then
        if upper then return upper end
        if torso then return torso end
        if hrp then return hrp end
        local parts=getCharParts(char)
        if #parts>0 then
            table.sort(parts,function(a,b) return a.Position.Y>b.Position.Y end)
            return parts[math.floor(#parts/2)]
        end
    elseif mode=="Ngẫu Nhiên" then
        local parts=getCharParts(char)
        if #parts>0 then return parts[math.random(1,#parts)] end
    elseif mode=="Gần Nhất" then
        if hrp then return hrp end
        local parts=getCharParts(char)
        if #parts>0 then
            local sum=Vector3.zero
            for _,p in ipairs(parts) do sum=sum+p.Position end
            local center=sum/#parts
            local closest,minD=nil,math.huge
            for _,p in ipairs(parts) do
                local d=(p.Position-center).Magnitude
                if d<minD then minD=d closest=p end
            end
            return closest
        end
    end
    return head or hrp
end

